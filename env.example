# ===== Bot =====
# Токен бота от @BotFather
BOT_TOKEN=

# HTTPS-адрес мини-аппа. Проще всего — публичный домен этого же сервиса на Railway,
# т.к. бот сам отдаёт webapp/index.html по адресу /  (например https://oncedshop-bot.up.railway.app)
WEBAPP_URL=

# Username поддержки без @ (показывается в текстах)
SUPPORT_USERNAME=oncedshopsupport

# Путь к SQLite. На Railway подключите Volume в /data и укажите /data/oncedshop.db
DB_PATH=/data/oncedshop.db

# ===== Админы / поддержка =====
# Ваш Telegram ID (узнать: отправьте боту /id). Несколько — через запятую.
# ОБЯЗАТЕЛЬНО: сюда приходят сообщения покупателей и уведомления об оплатах.
ADMIN_IDS=

# Username админа без @ (дополнительно к ADMIN_IDS)
ADMIN_USERNAME=oncedshopsupport

# Необязательно: ID группы поддержки (отрицательное число, например -1001234567890).
# Если задано — сообщения клиентов идут в эту группу, отвечать может вся команда.
# Добавьте бота в группу и отправьте там /id, чтобы узнать Chat ID.
SUPPORT_CHAT_ID=

# ===== Web server (мини-апп + API) =====
# Railway задаёт PORT сам. RUN_WEBSERVER=1 — оставить.
PORT=8080
RUN_WEBSERVER=1
WEBAPP_ORIGIN=*

# ===== Монитор чатов (Telethon userbot, опционально) =====
TG_API_ID=
TG_API_HASH=
TG_SESSION=
MONITOR_CHATS=FunPayPlace
MONITOR_TRIGGERS=поставщик,постав,#ищу,#куплю
MONITOR_NOTIFY_ADMIN=1
